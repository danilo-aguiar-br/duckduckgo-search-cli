# Build artifacts
/target/
**/*.rs.bk

# Logs
/logs/
*.log

# SBOM local gerado por `cargo cyclonedx` em testes locais
# (nao deve ser commitado; o CI gera `sbom.cdx.json` no runner)
duckduckgo-search-cli.cdx.json

# Secrets
*.pem
*.key
*.p12
*.pfx
.env

# Developer-private
/.serena/
/.claude/
/.setting.cyber/
# Root-only developer private files (do NOT use unanchored AGENTS.md — that also hid docs/AGENTS.md from git)
/CLAUDE.md
/AGENTS.md
ralph-loop.local.md
/docs_prd/
/docs_rules/
projeto_duckduckgo-search-cli.md
# Local audit inventory only (NOT published; excluded from crates.io via Cargo.toml).
# There is no docs/gaps.md — single source is root /gaps.md (gitignored).
/gaps.md

# GraphRAG / local SQLite DBs — ANY directory (root, nested, tooling subtrees)
**/graphrag.sqlite
**/graphrag.sqlite-shm
**/graphrag.sqlite-wal
**/.ingest-queue.sqlite
**/.ingest-queue.sqlite-shm
**/.ingest-queue.sqlite-wal
**/.enrich-queue.sqlite
**/.enrich-queue.sqlite-shm
**/.enrich-queue.sqlite-wal

# Archives
*.7z

# IDE
/.idea/
/.vscode/
*.swp
*.swo

# Coverage
*.profraw
*.profdata

# Nextest outputs
junit.xml
target/nextest/

# Property-based testing regression fixtures
proptest-regressions/

# Coverage HTML reports
coverage/
tarpaulin-report.html

# cargo-deny state
.cargo-deny-state.json

# Cargo lock for libraries (binaries keep Cargo.lock)
!Cargo.lock

.graphrag-backup/

# atomwrite sidecar WAL journals (v0.1.12+ consultive)
.atomwrite.journal.*.json

# criterion benchmark HTML reports (v0.8.0+)
target/criterion/


# BEGIN GH_SKILL_HYGIENE
# Managed by ~/.grok/skills/gh/scripts/pre-commit-hygiene.sh — do not hand-edit inside markers
# Ensures agent residual, secrets, DBs, media dumps and temp dirs never enter git
# Empty/whitespace-only patterns are rejected (never added). No *.lock patterns.
# --- extensions ---
*.7z
*.log
*.env
*.png
*.jpg
# --- name contains OR extension: .bak ---
*.bak
*.bak.*
*.*.bak
*.*.bak.*
# --- name contains OR extension: .tmp ---
*.tmp
*.tmp.*
*.*.tmp
*.*.tmp.*
# --- name contains OR extension: .journal ---
*.journal
*.journal.*
*.*.journal
*.*.journal.*
# --- name contains OR extension: .atomwrite_tmp ---
*.atomwrite_tmp
*.atomwrite_tmp.*
*atomwrite_tmp*
# --- name contains: _tmp ---
*_tmp*
# --- name contains: .atomwrite- ---
*.atomwrite-*
*atomwrite-*
# --- name contains: .atom_ ---
*.atom_*
*atom_*
# --- name contains: .atom- ---
*.atom-*
*atom-*
# --- name contains: ._agent_tmp ---
*._agent_tmp*
._agent_tmp*
# --- name contains: agent_tmp ---
*agent_tmp*
# --- name contains: .tmp_ ---
*.tmp_*
*.*.tmp_*
# --- named files (any depth) ---
gaps.md
**/gaps.md
graphrag.sqlite
**/graphrag.sqlite
graphrag.sqlite.enrich-queue.sqlite
**/graphrag.sqlite.enrich-queue.sqlite
graphrag.sqlite-wal
**/graphrag.sqlite-wal
.enrich-queue.sqlite
**/.enrich-queue.sqlite
.enrich-queue.sqlite-shm
**/.enrich-queue.sqlite-shm
.ingest-queue.sqlite-shm
**/.ingest-queue.sqlite-shm
.ingest-queue.sqlite-wal
**/.ingest-queue.sqlite-wal
CLAUDE.md
/CLAUDE.md
.commit_hash
**/.commit_hash
