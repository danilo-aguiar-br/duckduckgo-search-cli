{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danilo-aguiar-br/duckduckgo-search-cli/raw/main/docs/schemas/probe-deep-output.schema.json",
  "title": "ProbeDeepOutput",
  "description": "Output of `--probe-deep` (v0.7.3+). CAPTCHA detection with mitigation hints. v1.0.2 adds `deep_research_budget` SSOT snapshot (CM-10). Production path uses Chrome DOM (GAP-WS-113 / ADR-0016). Wire keys: English default (v1.0.2 / ADR-0027); PT aliases accepted on deserialize.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "description": "ok | captcha | error"
    },
    "endpoint": {
      "type": "string",
      "enum": [
        "html"
      ],
      "description": "Endpoint that was probed (currently only html)."
    },
    "http_status": {
      "type": "integer",
      "description": "HTTP status code of the probe response (often 202 even when captcha is detected)."
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall-clock latency of the probe."
    },
    "cascade_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Cascade level reached during the probe (0..=4)."
    },
    "cascade_reason": {
      "type": "string",
      "description": "Identifier of the failure mode (e.g., 'cloudflare_anomaly_modal', 'ddg_anomaly'). 'none' when no failure."
    },
    "mitigation_suggestion": {
      "type": "string",
      "description": "Actionable mitigation hint when status='captcha'."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "URL that was probed."
    },
    "identity_used": {
      "type": "string",
      "description": "Identity tag from the 12-identity pool."
    },
    "deep_research_budget": {
      "type": "object",
      "description": "SSOT deep-research product-default budget snapshot (v1.0.2 / CM-10). Pure local math.",
      "properties": {
        "estimate_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "gated_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "global_timeout_default": {
          "type": "integer",
          "minimum": 1
        },
        "budget_ok": {
          "type": "boolean"
        },
        "max_sub_queries": {
          "type": "integer",
          "minimum": 1
        },
        "fetch_content": {
          "type": "boolean"
        },
        "fetch_content_cap": {
          "type": "integer",
          "minimum": 1
        },
        "dual_vertical": {
          "type": "boolean"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "margin_percent": {
          "type": "integer",
          "minimum": 0
        },
        "serp_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "fetch_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "type": {
      "type": "string",
      "description": "Discriminator, e.g. probe_deep."
    },
    "used_chrome": {
      "type": "boolean"
    },
    "chrome_attempted": {
      "type": "boolean"
    },
    "error": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
